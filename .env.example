# Otter environment configuration
# Copy this file to .env and adjust values for your environment.
# Never commit .env or real credentials.

# Application and logging
APP_ENV=development
LOG_FORMAT=text
RUST_LOG=info

# HTTP server
HOST=0.0.0.0
PORT=8080

# Execution limits
MAX_CONCURRENT=8
CPU_LIMIT_MS=5000
WALL_LIMIT_MS=10000
MEMORY_LIMIT_MB=128
MAX_OUTPUT_BYTES=1048576
MAX_QUEUE_DEPTH=100
MAX_CONCURRENT_PER_IP=2
MAX_CONCURRENT_PER_USER=2

# Sandbox
# Leave DISABLE_SANDBOX unset so the application can automatically detect
# whether bubblewrap/user namespaces are supported by the host.
# Set this to true only when you intentionally need unsandboxed execution.
# DISABLE_SANDBOX=false

# Optional Redis backend. Leave commented to use the in-memory store.
# For local Docker Compose, use redis://redis:6379 inside the API container.
# REDIS_URL=redis://127.0.0.1:6379

# Optional API authentication.
# Uncomment and replace both values with strong, unique secrets before exposing
# the service publicly. Leaving them commented allows anonymous access.
# OTTER_API_KEY=replace-with-a-long-random-api-key
# OTTER_ADMIN_KEY=replace-with-a-different-long-random-admin-key

# Optional token & identity-aware rate limiting (propagated user identity from backend).
# OTTER_IDENTITY_MODE=jwt             # Options: jwt, trusted_header, or leave unset for standard API key / IP fallback
# OTTER_JWT_SECRET=replace-with-a-shared-secret-for-user-assertions
# OTTER_JWT_ISSUER=https://backend.example.com
# OTTER_JWT_AUDIENCE=otter

# Optional rate limiting. Set both values to enable it.
# Quotas apply per authenticated user (when assertions are provided), per API key, or per IP.
# RATE_LIMIT_REQUESTS=100
# RATE_LIMIT_WINDOW_SECONDS=60

# Comma-separated list of trusted reverse proxy IPs. Forwarded IP headers (X-Forwarded-For,
# X-Real-IP) will only be honored if the immediate TCP peer is in this list.
# TRUSTED_PROXIES=10.0.0.1,172.18.0.1

# Keep false unless loopback webhook targets are explicitly needed for testing.
ALLOW_LOOPBACK_WEBHOOKS=false

# Optional: presence of this variable forces process-count enforcement outside
# production, containers, or CI. Leave commented unless you need that behavior.
# OTTER_ENFORCE_NPROC=1
